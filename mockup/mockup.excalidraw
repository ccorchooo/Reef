      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Ik9RSb5PmHWhTa68QSbrT",
      "type": "text",
      "x": 4390.187748315373,
      "y": 121.5313998618002,
      "width": 469.0833435058594,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 993192471,
      "version": 1499,
      "versionNonce": 863263383,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795458807779,
      "created": 1795458480433,
      "link": null,
      "locked": false,
      "text": "The Expressive Island will be an interpretation\nof Apple's Dynamic Island. It will display current\nactions (music, timers, recordings, notifications, etc), \na shelf with a place to store text, images, files temporarily \nto transport them, the clipboard, emoji picker, calculator,\nand other actions.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Expressive Island will be an interpretation\nof Apple's Dynamic Island. It will display current\nactions (music, timers, recordings, notifications, etc), \na shelf with a place to store text, images, files temporarily \nto transport them, the clipboard, emoji picker, calculator,\nand other actions.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
