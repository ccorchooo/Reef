    {
      "id": "SxMRz4nhfJxmeHf_6kWdT",
      "type": "text",
      "x": -64.93914745530242,
      "y": 2812.055069845781,
      "width": 321.51666259765625,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 1718108311,
      "version": 422,
      "versionNonce": 318427321,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795458866069,
      "created": 1795457885528,
      "link": null,
      "locked": false,
      "text": "The circle in the middle is the Expressive\nIsland that morphs into the Expressive\nOrb which shows a special widget based\non current actions (music, timers, etc) or\na configurable default display (clock, \nweather, system performance, etc).",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The circle in the middle is the Expressive\nIsland that morphs into the Expressive\nOrb which shows a special widget based\non current actions (music, timers, etc) or\na configurable default display (clock, \nweather, system performance, etc).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IFr-L5tDfDj_XFkRKmw31",
      "type": "text",
      "x": -76.74430960939083,
      "y": 3668.0953614244095,
      "width": 344.5666809082031,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b0p8",
      "roundness": null,
      "seed": 1415471129,
      "version": 857,
      "versionNonce": 1771347063,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795459196860,
      "created": 1795459058598,
      "link": null,
      "locked": false,
      "text": "When Ctrl+Alt+Delete or a button for power\nactions is pressed, the bar collapses the \nmain island (the one with the home, search, \nworkspace buttons) into actions like power\noff, restart, lock, log out, etc.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When Ctrl+Alt+Delete or a button for power\nactions is pressed, the bar collapses the \nmain island (the one with the home, search, \nworkspace buttons) into actions like power\noff, restart, lock, log out, etc.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "fI2mi6JInOTF8j9_PnuC5",
      "type": "text",
      "x": -60.442809592088224,
      "y": 1999.1645525187491,
      "width": 319.95001220703125,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b0pG",
      "roundness": null,
      "seed": 1350998297,
      "version": 858,
      "versionNonce": 1356843065,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795458478409,
      "created": 1795458266747,
      "link": null,
      "locked": false,
      "text": "The AI assistant will be housed on the\nExpressive Island with animations as it\ntalks and when it finishes generating the\nresponse it opens the chat view as it\ntalks. API endpoint and model \nconfigurations will be selected on the\nSettings app.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The AI assistant will be housed on the\nExpressive Island with animations as it\ntalks and when it finishes generating the\nresponse it opens the chat view as it\ntalks. API endpoint and model \nconfigurations will be selected on the\nSettings app.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "KIqqbygO5CGzL4qw1kY9d",
      "type": "text",
      "x": -67.74808927905917,
      "y": 2943.247365562865,
      "width": 313.8333435058594,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b0pV",
      "roundness": null,
      "seed": 1712659161,
      "version": 572,
      "versionNonce": 1756516761,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795458866069,
      "created": 1795458222931,
      "link": null,
      "locked": false,
      "text": "The three buttons beside the password\nare the sleep, power off and restart \nbuttons.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The three buttons beside the password\nare the sleep, power off and restart \nbuttons.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "8m9Zp9XspoFYEo0ZMQNF4",
      "type": "text",
      "x": -72.55490601942688,
      "y": 2928.4907183997666,
      "width": 298.8556719914393,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 705860823,
      "version": 47,
      "versionNonce": 391433497,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1795458221238,
      "created": 1795458216157,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
