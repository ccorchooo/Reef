# Reef, a Quickshell desktop shell for Hyprland, built from the latest commit.
# Build:  cd packaging/arch && makepkg -si
# Installs Reef to /usr/share/reef (the shell, Hyprland's config, app configs, the greeter),
# `reef` and `reef-session` to /usr/bin, the Reef session entry, and links
# /etc/xdg/quickshell/reef so `qs -c reef` finds it. Then, as yourself:
#     reef install --no-packages      (your Hyprland config, kitty, fonts, greeter…)
# Keep depends in step with bin/reef's package lists.
pkgname=reef-git
pkgver=r0
pkgrel=1
pkgdesc="Reef: a Quickshell desktop shell for Hyprland, with M3 Expressive motion"
arch=('any')
url="https://github.com/ccorchooo/Reef"
# Reef has no license file yet; the bundled fonts are OFL-1.1 (Google Sans Flex, Google
# Sans Code) and Apache-2.0 (Material Symbols Rounded).
license=('LicenseRef-unknown' 'OFL-1.1' 'Apache-2.0')
depends=(
    'quickshell'      # 0.3.2 or newer (AUR: quickshell or quickshell-git)
    'hyprland'
    'pipewire' 'pipewire-audio'   # audio; pw-play for the UI sounds
    'wl-clipboard' 'cliphist'
    'grim' 'slurp'
    'curl' 'ffmpeg' 'file' 'xdg-utils'
    'glib2' 'systemd' 'util-linux' 'procps-ng'
    'brightnessctl' 'bluez-utils'
    'upower' 'power-profiles-daemon'
    'uwsm' 'xdg-desktop-portal-hyprland' 'xdg-desktop-portal-gtk'
    'networkmanager' 'polkit' 'gnome-keyring' 'libnotify' 'lua'
    'kitty' 'fastfetch' 'starship'
)
optdepends=(
    'cava: the audio visualizer'
    'whisper-cpp: Coral listening and the wake word on this computer'
    'piper-tts: Coral speaking on this computer'
    'poppler: PDF attachments in Coral'
    'nvidia-utils: GPU temperature in the system widget'
    'gpu-screen-recorder: screen recording'
    'network-manager-applet: advanced Wi-Fi settings'
    'blueman: advanced Bluetooth settings'
    'pwvucontrol: the volume mixer'
    'greetd: the login greeter (reef install --greeter)'
    'hyprpicker: the color picker'
    'btop: the system monitor (Ctrl+Shift+Escape)'
    'wtype: typing the newest clipboard entry'
    'adw-gtk-theme: GTK apps in the Reef colors'
)
makedepends=('git')
provides=('reef')
conflicts=('reef')
source=("reef::git+https://github.com/ccorchooo/Reef.git")
sha256sums=('SKIP')

pkgver() {
    cd reef
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
    cd reef
    ./bin/reef prefix "$pkgdir"
}
